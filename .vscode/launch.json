            "projectName": "meter-monitor",
            "cwd": "${workspaceFolder}\\backend",
            "preLaunchTask": "Meterly: Start PostgreSQL",
            "env": {
                "JAVA_HOME": "C:\\Program Files\\Eclipse Adoptium\\jdk-21.0.11.10-hotspot",
                "DATABASE_URL": "jdbc:postgresql://localhost:5434/meters",
                "DATABASE_USERNAME": "meters",
                "DATABASE_PASSWORD": "meters",
                "JWT_SECRET": "VGhpcy1pcy1hLWxvY2FsLWRldmVsb3BtZW50LXNlY3JldC1mb3ItbWV0ZXJseQ==",
                "UPLOAD_DIRECTORY": "${workspaceFolder}\\backend\\data\\uploads",
                "TESSDATA_PATH": "C:\\Program Files\\Tesseract-OCR\\tessdata",
                "CORS_ALLOWED_ORIGINS": "http://localhost:3000,http://localhost:5173"
