# PostgreSQL / серверная часть
DATABASE_URL=jdbc:postgresql://localhost:5434/meters
DATABASE_USERNAME=meters
DATABASE_PASSWORD=meters
JWT_SECRET=replace-with-a-base64-encoded-secret-of-at-least-256-bits
JWT_EXPIRATION=PT8H
UPLOAD_DIRECTORY=./data/uploads
UPLOAD_MAX_BYTES=10485760
UPLOAD_MAX_SIZE=10MB
UPLOAD_RETENTION=P30D
OCR_MINIMUM_CONFIDENCE=0.80
OCR_WORKER_ENABLED=true
TESSDATA_PATH=
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Интерфейс
NEXT_PUBLIC_API_URL=http://localhost:8080
